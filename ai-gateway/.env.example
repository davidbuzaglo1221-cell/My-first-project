# Copy to .env.local (never commit it). On Vercel: Project → Settings → Environment Variables.
# Required: a long random access code the apps and the dashboard send. Without it the gateway refuses everything.
APP_ACCESS_TOKEN=
# Claude — the main model (paid). Leave empty to run on free models only.
ANTHROPIC_API_KEY=
# Your FreeLLMAPI server (origin, e.g. https://llm.example.com) and its unified key (freellmapi-…).
FREELLMAPI_URL=
FREELLMAPI_KEY=
# Free-tier provider keys — each is optional; fill in any you have.
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# 1 = allow the no-key providers (OVH, Kilo) as a last resort. Kilo keeps prompts for training.
ALLOW_KEYLESS=0
# Comma-separated browser origins allowed to call the gateway.
ALLOWED_ORIGINS=https://davidbuzaglo1221-cell.github.io

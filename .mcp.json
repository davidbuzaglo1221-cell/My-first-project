{
  "mcpServers": {
    "claude-flow": {
      "command": "npx",
      "args": [
        "-y",
        "ruflo@3.80.1",
        "mcp",
        "start"
      ],
      "env": {
        "npm_config_update_notifier": "false",
        "CLAUDE_FLOW_MODE": "v3",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDE_FLOW_TOPOLOGY": "hierarchical-mesh",
        "CLAUDE_FLOW_MAX_AGENTS": "6",
        "CLAUDE_FLOW_MEMORY_BACKEND": "hybrid",
        "CLAUDE_FLOW_MCP_TOOLS": "memory,swarm,agent,task,workflow,coordination,session,aidefence,hive-mind",
        "RUFLO_FUNNEL": "0",
        "RUFLO_NO_AUTO_ENABLE": "1"
      },
      "autoStart": false
    }
  }
}

// Records every lesson with a studio voice (ElevenLabs) into public/audio/lessons/<id>.mp3, then
// writes src/lib/journey/lesson-audio.ts so the app plays the recording instead of the device voice.
//
//   npm run audio                      record what is missing
//   npm run audio -- --force           record everything again
//   npm run audio -- --voices          list the voices on the account
//   VOICE_ID=... MODEL=... npm run audio
//
// The key: ELEVENLABS_API_KEY, or none in a cloud session whose network adds it for api.elevenlabs.io.
import { mkdirSync, readdirSync, writeFileSync, existsSync } from "node:fs";
import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { ACADEMY, narration } from "../src/lib/journey/academy.ts";
import { LESSONS } from "../src/lib/lessons.ts";

const root = resolve(dirname(fileURLToPath(import.meta.url)), "..");
const out = resolve(root, "public/audio/lessons");
const API = "https://api.elevenlabs.io/v1";
const KEY = process.env.ELEVENLABS_API_KEY ?? "sk_injected_by_proxy";
// A calm, deep multilingual narrator by default; any voice on the account can be chosen.
const VOICE = process.env.VOICE_ID ?? "JBFqnCBsd6RMkjVDRZzb";
// eleven_v3 reads Hebrew; the older multilingual models do not.
const MODEL = process.env.MODEL ?? "eleven_v3";
const args = new Set(process.argv.slice(2));

async function api(path: string, init: RequestInit = {}) {
  const res = await fetch(API + path, { ...init, headers: { "xi-api-key": KEY, ...(init.headers ?? {}) } });
  if (!res.ok) throw new Error(`${res.status} ${await res.text()}`);
  return res;
}

if (args.has("--voices")) {
  const { voices } = (await (await api("/voices")).json()) as { voices: { voice_id: string; name: string; labels?: Record<string, string> }[] };
  for (const v of voices) console.log(v.voice_id, v.name, JSON.stringify(v.labels ?? {}));
  process.exit(0);
}

const items = [
  ...ACADEMY.map((l) => ({ id: l.id, text: narration(l) })),
  ...LESSONS.map((l) => ({ id: `learn-${l.id}`, text: [l.title + ".", ...l.body, "לנסות היום.", l.tryToday].join("\n\n") })),
];

mkdirSync(out, { recursive: true });
let made = 0;
for (const it of items) {
  const file = resolve(out, `${it.id}.mp3`);
  if (existsSync(file) && !args.has("--force")) continue;
  process.stdout.write(`${it.id} (${it.text.length} chars)… `);
  const res = await api(`/text-to-speech/${VOICE}?output_format=mp3_44100_96`, {
    method: "POST",
    headers: { "content-type": "application/json" },
    body: JSON.stringify({ text: it.text, model_id: MODEL, language_code: "he", voice_settings: { stability: 0.5, similarity_boost: 0.8, style: 0.2, use_speaker_boost: true } }),
  });
  writeFileSync(file, Buffer.from(await res.arrayBuffer()));
  made++;
  console.log("ok");
}

const recorded = readdirSync(out).filter((f) => f.endsWith(".mp3")).map((f) => f.slice(0, -4)).sort();
writeFileSync(
  resolve(root, "src/lib/journey/lesson-audio.ts"),
  `// Generated by scripts/lesson-audio.mts: the lessons that have a studio recording in
// public/audio/lessons/<id>.mp3. Lessons not listed here are read by the device voice.
export const RECORDED = new Set<string>(${JSON.stringify(recorded, null, 2)});
`,
);
console.log(`recorded ${made} new, ${recorded.length} in all`);

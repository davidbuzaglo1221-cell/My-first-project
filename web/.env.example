# Copy to .env.local and fill in. Never commit real values.
ANTHROPIC_API_KEY=
APP_ACCESS_TOKEN=

# Listening (lessons read aloud). Without a key the app uses the phone's own Hebrew voice.
# Google Cloud Text-to-Speech, Chirp 3 HD voices (recommended):
GOOGLE_TTS_API_KEY=
# Or Microsoft Azure Speech:
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional: "google" or "azure" when both keys are set (Google is used first otherwise).
TTS_PROVIDER=

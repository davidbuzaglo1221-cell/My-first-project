{
  "name": "ascend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/make-ics.mjs && vite build",
    "build:single": "node scripts/audio-manifest.mjs && vite build --mode single && node scripts/artifact.mjs",
    "build:pwa": "node scripts/audio-manifest.mjs && node scripts/make-ics.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/assistant": "^5.3.0",
    "@fontsource/frank-ruhl-libre": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.7"
  }
}

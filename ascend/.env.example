# Server-side only (Vercel → Project → Settings → Environment Variables). Never prefix these with VITE_.
ANTHROPIC_API_KEY=        # the book tutor and library guide (/api/assistant)
AZURE_SPEECH_KEY=         # Hila / Avri neural voices for spoken answers (/api/tts), Azure free tier F0
AZURE_SPEECH_REGION=      # e.g. westeurope
ALLOWED_ORIGINS=          # extra sites allowed to call the server, comma separated (GitHub Pages is built in)
# AI_MODEL=claude-opus-5-5

# Build-time, public: where the GitHub Pages build finds the server (leave empty when app and server share a host)
VITE_AI_BASE=

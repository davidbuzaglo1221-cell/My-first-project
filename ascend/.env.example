# Server-side only. Never prefix these with VITE_, and never commit real values.
# AI coach (optional). Without ANTHROPIC_API_KEY the app uses the built-in basic coach.
ANTHROPIC_API_KEY=
# Recommended when deployed: requests to /api/coach must send this value in the x-ascend-token header.
ASCEND_ACCESS_TOKEN=
# Optional model override.
ASCEND_COACH_MODEL=claude-sonnet-5-5
